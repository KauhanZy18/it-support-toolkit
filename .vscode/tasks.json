{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IT Support Toolkit: Abrir menu",
      "type": "shell",
      "command": "python",
      "args": ["-m", "src"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "IT Support Toolkit: Executar testes",
      "type": "shell",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "IT Support Toolkit: Informações do computador",
      "type": "shell",
      "command": "python",
      "args": ["-m", "src.system_info"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    }
  ]
}
